# ODrive Go: Environment Configuration
# Copy this file to .env before starting the service.

# Server Network Settings
PORT=8090
HOST=0.0.0.0

# Master Vault Encryption Secret (32-character passphrase for AES-256-GCM)
# Encrypts provider tokens and credentials at rest.
ODRIVE_SECRET_KEY=replace-with-a-very-secure-32-byte-secret-key!

# Database Configuration
# PostgreSQL:
DATABASE_URL=postgres://odrive:odrive_secret_password@127.0.0.1:5432/odrive?sslmode=disable
# SQLite Fallback:
# DATABASE_URL=./data/odrive.db

# Root Administrator Account
ODRIVE_ROOT_EMAIL=admin@example.local
# Leave empty to generate a random secure password on first start:
ODRIVE_ROOT_PASSWORD=replace-with-a-secure-password

# Application Service API Keys (Optional overrides: leave blank to auto-generate)
# ODRIVE_KEY_CLIENT_APP=odrv_live_app_your_secure_hex_key
# ODRIVE_KEY_BACKUP_WORKER=odrv_live_backup_your_secure_hex_key

# Google Drive Provider OAuth Settings (Optional: can also be configured via Web UI)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REDIRECT_URL=http://localhost:8090/api/v1/auth/google/callback

# S3 Gateway Settings
S3_ENDPOINT=http://127.0.0.1:8090/s3
S3_DEFAULT_BUCKET=media-library
S3_REGION=us-east-1
